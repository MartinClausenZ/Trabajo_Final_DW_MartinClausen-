<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head', { title: 'Editar perfil' }) %>
</head>
<body>

  <%- include('../partials/header') %>

  <section class="auth-page">
    <div class="container">
      <div class="auth-card" style="max-width: 560px;">
        <h1>Editar perfil</h1>

        <form action="/users/profile?_method=PUT" method="POST" enctype="multipart/form-data" id="profileForm" novalidate>

          <div class="form-group">
            <label for="firstName">Nombre</label>
            <input type="text" id="firstName" name="firstName" value="<%= user.firstName %>" required>
            <% if (errors && errors.firstName) { %>
              <p class="error-message visible"><%= errors.firstName %></p>
            <% } %>
          </div>

          <div class="form-group">
            <label for="lastName">Apellido</label>
            <input type="text" id="lastName" name="lastName" value="<%= user.lastName %>" required>
            <% if (errors && errors.lastName) { %>
              <p class="error-message visible"><%= errors.lastName %></p>
            <% } %>
          </div>

          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" value="<%= user.email %>" required>
            <% if (errors && errors.email) { %>
              <p class="error-message visible"><%= errors.email %></p>
            <% } %>
          </div>

          <div class="form-group">
            <label for="password">Nueva contraseña</label>
            <input type="password" id="password" name="password" placeholder="Dejá vacío para no cambiarla">
            <p class="field-hint">Solo completá si querés cambiar tu contraseña</p>
            <% if (errors && errors.password) { %>
              <p class="error-message visible"><%= errors.password %></p>
            <% } %>
          </div>

          <div class="form-group">
            <label for="image">Foto de perfil</label>
            <input type="file" id="image" name="image" accept="image/*" style="font-size:0.9rem;">
            <% if (user.image && user.image.includes('.')) { %>
              <p class="field-hint">Imagen actual: <%= user.image %></p>
            <% } %>
            <% if (errors && errors.image) { %>
              <p class="error-message visible"><%= errors.image %></p>
            <% } %>
          </div>

          <button type="submit" class="btn btn-primary btn-full">Guardar cambios</button>

        </form>

        <p class="auth-footer" style="margin-top: 16px;">
          <a href="/users/profile">← Volver al perfil</a>
        </p>

      </div>
    </div>
  </section>

  <%- include('../partials/footer') %>

  <script src="/js/validations-profile.js"></script>

</body>
</html>