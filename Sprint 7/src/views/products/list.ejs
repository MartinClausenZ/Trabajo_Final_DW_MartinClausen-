<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head', { title: 'Productos' }) %>
</head>
<body>

  <%- include('../partials/header') %>

  <section class="product-list-page">
    <div class="container">
      <div class="list-header">
        <h1><%= activeCat ? activeCat.charAt(0).toUpperCase() + activeCat.slice(1) : 'Todos los productos' %></h1>
        <a href="/products/create" class="btn btn-accent">+ Crear producto</a>
      </div>

      <!-- Buscador -->
      <form class="search-bar" method="GET" action="/products" style="display:flex; gap:8px; margin-bottom:16px;">
        <input type="text" name="search" value="<%= searchQuery || '' %>" placeholder="Buscar productos..." style="flex:1; padding:10px 14px; border:1px solid var(--gris-medio); border-radius:var(--radius); font-size:0.9rem; outline:none;">
        <button type="submit" class="btn btn-primary" style="padding:10px 20px;">🔍</button>
      </form>

      <!-- Filtros de categoría -->
      <div class="category-filters">
        <a href="/products" class="filter-btn <%= !activeCat ? 'active' : '' %>">Todos</a>
        <a href="/products?cat=plantas" class="filter-btn <%= activeCat === 'plantas' ? 'active' : '' %>">Plantas</a>
        <a href="/products?cat=macetas" class="filter-btn <%= activeCat === 'macetas' ? 'active' : '' %>">Macetas</a>
        <a href="/products?cat=decoracion" class="filter-btn <%= activeCat === 'decoracion' ? 'active' : '' %>">Decoración</a>
        <a href="/products?cat=accesorios" class="filter-btn <%= activeCat === 'accesorios' ? 'active' : '' %>">Accesorios</a>
      </div>

      <div class="products-grid">
        <% products.forEach(function(product) { %>
          <%- include('../partials/productCard', { product }) %>
        <% }); %>
      </div>

      <% if (products.length === 0) { %>
        <div class="empty-state">
          <p>🌱 No hay productos en esta categoría todavía.</p>
          <a href="/products/create" class="btn btn-primary">Crear el primero</a>
        </div>
      <% } %>
    </div>
  </section>

  <%- include('../partials/footer') %>

</body>
</html>