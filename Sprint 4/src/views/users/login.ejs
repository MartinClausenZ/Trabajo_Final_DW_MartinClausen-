<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head', { title: 'Iniciar sesión' }) %>
</head>
<body>

  <%- include('../partials/header') %>

  <!-- LOGIN -->
  <section class="auth-page">
    <div class="container">
      <div class="auth-card">
        <h1>Iniciar sesión</h1>

        <form action="/users/login" method="POST">

          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="tu@email.com">
          </div>

          <div class="form-group">
            <label for="password">Contraseña</label>
            <input type="password" id="password" name="password" class="error" placeholder="Tu contraseña">
            <p class="error-message visible">La contraseña es incorrecta</p>
          </div>

          <div class="remember-me">
            <label class="checkbox-label">
              <input type="checkbox" name="remember">
              Recordarme
            </label>
            <a href="#" class="forgot-link">¿Olvidaste tu contraseña?</a>
          </div>

          <button type="submit" class="btn btn-primary btn-full">Ingresar</button>

        </form>

        <div class="divider">o</div>

        <button type="button" class="btn-google">
          <span>🔵</span> Continuar con Google
        </button>

        <p class="auth-footer">
          ¿No tenés cuenta? <a href="/users/register">Registrate</a>
        </p>

      </div>
    </div>
  </section>

  <%- include('../partials/footer') %>

</body>
</html>