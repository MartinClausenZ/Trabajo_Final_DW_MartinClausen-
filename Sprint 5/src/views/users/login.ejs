<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head', { title: 'Iniciar sesión' }) %>
</head>
<body>

  <%- include('../partials/header') %>

  <section class="auth-page">
    <div class="container">
      <div class="auth-card">
        <h1>Iniciar sesión</h1>

        <form action="/users/login" method="POST">

          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="tu@email.com" value="<%= old && old.email || '' %>" required>
            <% if (errors && errors.email) { %>
              <p class="error-message visible"><%= errors.email %></p>
            <% } %>
          </div>

          <div class="form-group">
            <label for="password">Contraseña</label>
            <input type="password" id="password" name="password" placeholder="Tu contraseña" required>
            <% if (errors && errors.password) { %>
              <p class="error-message visible"><%= errors.password %></p>
            <% } %>
          </div>

          <div class="remember-me">
            <label class="checkbox-label">
              <input type="checkbox" name="remember" <% if (old && old.remember) { %>checked<% } %>>
              Recordarme
            </label>
            <a href="#" class="forgot-link">¿Olvidaste tu contraseña?</a>
          </div>

          <button type="submit" class="btn btn-primary btn-full">Ingresar</button>

        </form>

        <div class="divider">o</div>

        <button type="button" class="btn-google">
          <span>🔵</span> Continuar con Google
        </button>

        <p class="auth-footer">
          ¿No tenés cuenta? <a href="/users/register">Registrate</a>
        </p>

      </div>
    </div>
  </section>

  <%- include('../partials/footer') %>

</body>
</html>