<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head', { title: 'Inicio' }) %>
</head>
<body>

  <%- include('partials/header') %>

  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <h1>Llená tu casa de verde</h1>
      <p>Plantas curadas + guía de cuidado incluida. Todo lo que necesitás para transformar tu hogar.</p>
      <a href="/products" class="btn btn-primary">Ver catálogo</a>
    </div>
  </section>

  <!-- CATEGORÍAS -->
  <section class="categories">
    <div class="container">
      <h2>Explorá por categoría</h2>
      <div class="categories-grid">
        <div class="category-card">
          <div class="category-img">🌿</div>
          <h3>Luz baja</h3>
        </div>
        <div class="category-card">
          <div class="category-img">🐾</div>
          <h3>Pet-friendly</h3>
        </div>
        <div class="category-card">
          <div class="category-img">💨</div>
          <h3>Purificadoras</h3>
        </div>
        <div class="category-card">
          <div class="category-img">🏺</div>
          <h3>Macetas</h3>
        </div>
      </div>
    </div>
  </section>

  <!-- PRODUCTOS DESTACADOS -->
  <section class="featured">
    <div class="container">
      <h2>Destacados</h2>
      <div class="products-grid">
        <%- include('partials/productCard', { emoji: '🪴', name: 'Monstera Deliciosa', variant: 'Maceta 20cm', rating: '★★★★★', reviews: '24', price: '$8.990', badge: 'Nuevo' }) %>
        <%- include('partials/productCard', { emoji: '🌱', name: 'Pothus Dorado', variant: 'Maceta 15cm', rating: '★★★★☆', reviews: '18', price: '$4.590', badge: '' }) %>
        <%- include('partials/productCard', { emoji: '🌵', name: 'Cactus San Pedro', variant: 'Maceta 12cm', rating: '★★★★★', reviews: '31', price: '$3.290', badge: '' }) %>
        <%- include('partials/productCard', { emoji: '🕯️', name: 'Vela Aromática Bosque', variant: 'Soy wax · 200g', rating: '★★★★☆', reviews: '12', price: '$5.990', badge: '-20%' }) %>
      </div>
    </div>
  </section>

  <!-- NEWSLETTER -->
  <section class="newsletter">
    <div class="container">
      <h2>Sumate al club verde</h2>
      <p>Recibí tips de cuidado, novedades y ofertas exclusivas en tu mail.</p>
      <form class="newsletter-form">
        <input type="email" placeholder="Tu email" required>
        <button type="submit" class="btn btn-primary">Enviar</button>
      </form>
    </div>
  </section>

  <%- include('partials/footer') %>

</body>
</html>