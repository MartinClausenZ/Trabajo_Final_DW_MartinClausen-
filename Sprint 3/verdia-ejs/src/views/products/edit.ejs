<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head', { title: 'Editar producto' }) %>
</head>
<body>

  <%- include('../partials/header') %>

  <section class="auth-page">
    <div class="container">
      <div class="auth-card" style="max-width: 560px;">
        <h1>Editar producto</h1>

        <form action="/products/1?_method=PUT" method="POST" enctype="multipart/form-data">

          <div class="form-group">
            <label for="name">Nombre del producto</label>
            <input type="text" id="name" name="name" value="Monstera Deliciosa">
          </div>

          <div class="form-group">
            <label for="description">Descripción</label>
            <textarea id="description" name="description" rows="4" style="width:100%; padding:12px 14px; border:1px solid var(--gris-medio); border-radius:var(--radius); font-size:0.9rem; resize:vertical; outline:none; font-family:inherit;">La Monstera Deliciosa, también conocida como costilla de Adán, es una de las plantas de interior más icónicas y deseadas.</textarea>
          </div>

          <div class="form-group">
            <label for="image">Imagen</label>
            <input type="file" id="image" name="image" accept="image/*" style="font-size:0.9rem;">
            <p style="font-size:0.8rem; color:var(--gris-oscuro); margin-top:6px;">Imagen actual: monstera.jpg</p>
          </div>

          <div class="form-group">
            <label for="category">Categoría</label>
            <select id="category" name="category" style="width:100%; padding:12px 14px; border:1px solid var(--gris-medio); border-radius:var(--radius); font-size:0.9rem; outline:none; background-color:var(--base); color:var(--texto);">
              <option value="">Seleccioná una categoría</option>
              <option value="plantas" selected>Plantas</option>
              <option value="macetas">Macetas</option>
              <option value="decoracion">Decoración</option>
              <option value="accesorios">Accesorios</option>
            </select>
          </div>

          <div class="form-group">
            <label for="colors">Colores / Tamaños</label>
            <input type="text" id="colors" name="colors" value="Verde, Maceta 20cm">
          </div>

          <div class="form-group">
            <label for="price">Precio ($)</label>
            <input type="number" id="price" name="price" value="8990" min="0" step="1">
          </div>

          <button type="submit" class="btn btn-primary btn-full">Guardar cambios</button>

        </form>

        <p class="auth-footer" style="margin-top: 16px;">
          <a href="/products">← Volver al listado</a>
        </p>

      </div>
    </div>
  </section>

  <%- include('../partials/footer') %>

</body>
</html>